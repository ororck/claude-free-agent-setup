{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM local",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "worker-a": {
          "name": "worker-a (Nemotron Ultra)"
        },
        "worker-b": {
          "name": "worker-b (Qwen 3.8 27B)"
        },
        "worker-c": {
          "name": "worker-c (Gemma 4 31B)"
        },
        "worker-d": {
          "name": "worker-d (stepfun step-3.7-flash)"
        },
        "verifier": {
          "name": "verifier (Gemini 3.6 Flash)"
        }
      }
    }
  },
  "model": "litellm/worker-a",
  "permission": {
    "read": {
      "*": "allow",
      "*.tfstate": "deny",
      "*.tfstate.*": "deny",
      "*.tfvars": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.tfstate*": "deny",
      "*.tfvars*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*kubeconfig*": "deny",
      "*.kube/*": "deny",
      "*/secrets/*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.tfstate": "deny",
      "*.tfstate.*": "deny",
      "*.tfvars": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.tfstate*": "deny",
      "*.tfvars*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*kubeconfig*": "deny",
      "*.kube/*": "deny",
      "*/secrets/*": "deny"
    },
    "bash": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "skill": "deny",
    "task": "deny",
    "grep": "deny",
    "glob": "deny"
  },
  "enabled_providers": [
    "litellm"
  ],
  "autoupdate": false
}
