{
  "env": {
    "CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git clone:*)",
      "Edit(.github/**)",
      "Write(.github/**)"
    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.tfstate*)",
      "Read(~/.litellm/.env)",
      "Read(~/.ssh/**)",
      "Read(secrets/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/kubeconfig)",
      "Read(.kube/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "skillOverrides": {
    "anthropic-skills:docx": "off",
    "anthropic-skills:learn": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:course-notes": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:algorithmic-art": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:web-artifacts-builder": "off",
    "anthropic-skills:theme-factory": "off",
    "anthropic-skills:import-memory": "off",
    "cowork-plugin-management:create-cowork-plugin": "off",
    "cowork-plugin-management:cowork-plugin-customizer": "off",
    "dataviz": "off",
    "claude-api": "off",
    "artifact-capabilities": "off",
    "artifact-diagramming": "off",
    "artifact-design": "off",
    "keybindings-help": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/mohamed/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/mohamed/.claude/hooks/guard-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/mohamed/.claude/hooks/guard-secrets-files.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'cols=${COLUMNS:-}; case \"$cols\" in \"\"|*[!0-9]*) cols=$(stty size 2>/dev/null </dev/tty | awk '\"'\"'{print $2}'\"'\"');; esac; case \"$cols\" in \"\"|*[!0-9]*) cols=120;; esac; export COLUMNS=$(( cols > 4 ? cols - 4 : 1 )); plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/*/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $(0) }'\"'\"' | grep -E '\"'\"'^[0-9]+\\.[0-9]+\\.[0-9]+[[:space:]]'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"/usr/bin/node\" \"${plugin_dir}dist/index.js\"'"
  },
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true,
    "cowork-plugin-management@synced": false,
    "claude-hud@claude-hud": true,
    "terrashark@terrashark": true,
    "claude-md-management@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "terrashark": {
      "source": {
        "source": "github",
        "repo": "LukasNiessen/terrashark"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 180000,
  "advisorModel": "opus",
  "theme": "light",
  "skipAutoPermissionPrompt": true
}
